{
  "name": "ieee754-converter",
  "displayName": "IEEE 754 Converter",
  "description": "IEEE 754 floating-point converter with arithmetic operations",
  "version": "0.0.1",
  "publisher": "karl",
  "icon": "icon.png",
  "extensionKind": [
    "ui"
  ],
  "keywords": [
    "ieee754",
    "floating-point",
    "converter",
    "binary",
    "hex"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ieee754",
          "title": "IEEE 754",
          "icon": "icon.svg"
        }
      ]
    },
    "views": {
      "ieee754": [
        {
          "type": "webview",
          "id": "ieee754.converter",
          "name": "Converter"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "test:engine": "node esbuild.js --test",
    "test": "node ./out/test/runTest.js",
    "package": "npm run build && npx vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.3.8",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.0"
  }
}
